# Copy to .env and replace paths with absolute paths on your machine.
# This file uses Bash assignment syntax. Only load configuration you trust.
REPO_DIR=/absolute/path/to/fr_translation
OUTPUT_DIR=/absolute/path/to/private/checkpoint
MODEL_DIR=/absolute/path/to/Llama-3.3-70B-Instruct
PYTHON=/absolute/path/to/venv/bin/python
BATCH_SIZE=8
MAX_MEMORY_PER_GPU=76GiB
STAGE_MODEL=1
# Optional absolute directory for the staged model; otherwise use JOBSCRATCH/TMPDIR.
MODEL_STAGE_DIR=
# Optional existing provenance JSON. Leave empty if the shared model has none.
MODEL_MANIFEST=
# Leave empty to preserve CUDA_VISIBLE_DEVICES from the scheduler.
# Outside SLURM, you can explicitly select four devices, e.g. 0,1,2,3.
GPU_DEVICES=
# 100 for a trial (100 new terms per shard); empty for full continuation.
MAX_SESSION_RECORDS=
WORKER_START_DELAY=45
